APP_NAME=Burgery
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost/burgery/public

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=burgery
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

# --- Akun admin awal (dipakai oleh `php artisan db:seed` / `php artisan burgery:admin`) ---
# Ini KREDENSIAL DEVELOPMENT. Ganti sebelum website dipublikasikan.
ADMIN_USERNAME=admin
ADMIN_NAME="Administrator Burgery"
ADMIN_EMAIL=admin@burgery.test
ADMIN_PASSWORD=Burgery@Admin2026
